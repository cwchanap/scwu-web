{
  "name": "scwu-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "assets": "python3 scripts/export_assets.py",
    "predev": "bun run assets",
    "dev": "vite --host 127.0.0.1",
    "build": "bash scripts/build.sh",
    "upload:r2": "bash scripts/upload_r2.sh",
    "preview": "vite preview --host 127.0.0.1",
    "check": "NODE_OPTIONS=--max-old-space-size=8192 svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "bun run assets && bun run format:check && bun run lint && bun run check && bun run test",
    "prepare": "husky"
  },
  "dependencies": {
    "jose": "6.2.18",
    "phaser": "^4.2.1",
    "svelte": "^5.59.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "bun@1.3.9"
}
