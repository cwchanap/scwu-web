{
  "name": "scwu-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "python3 scripts/export_assets.py",
    "predev": "bun run assets",
    "dev": "vite --host 127.0.0.1",
    "build": "bash scripts/build.sh",
    "upload:r2": "bash scripts/upload_r2.sh",
    "preview": "vite preview --host 127.0.0.1",
    "check": "NODE_OPTIONS=--max-old-space-size=8192 svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "bun run assets && bun run format:check && bun run lint && bun run check && bun run test",
    "prepare": "husky"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte-check": "^4.7.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.3.9"
}
