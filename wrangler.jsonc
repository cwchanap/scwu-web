{
  // Worker + static site: the built app in dist/ is served asset-first, and
  // requests without a matching asset reach the Worker in src/worker/index.ts
  // (the /api/* endpoints; there is no SPA fallback). The art and audio (about
  // 28,000 files in the export) are over Worker assets' 20,000-file limit;
  // they are published to R2 by the owner's choice, see README.
  "name": "scwu-web",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-31",
  "assets": { "directory": "./dist" },
  // Required by `wrangler preview` (Workers Builds on non-production branches).
  // Previews don't inherit production settings; this one needs none.
  "previews": {},
  // HPA-768, before the first integrated Preview the owner provisions and the
  // repo then commits the non-secret values (never invented placeholders):
  //   "vars": { "GOOGLE_CLIENT_ID": "<the OAuth web client ID>" },
  //   "d1_databases": [
  //     { "binding": "DB", "database_name": "scwu-web",
  //       "database_id": "<the production database's id>" }
  //   ],
  // and inside "previews" the same public client ID plus a *separate* shared
  // "scwu-web-preview" database id. SESSION_SECRET (>= 32 UTF-8 bytes) stays a
  // per-environment Worker secret and is never committed; locally it lives in
  // the gitignored .dev.vars. wrangler.preview-migrations.jsonc is added once
  // the preview database id exists.
}
